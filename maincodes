    decoder2_4 dec2(W4[1:0], enbl[0], Y16 [3:0]);
    decoder2_4 dec3(W4[1:0], enbl[1], Y16 [7:4]);
    decoder2_4 dec4(W4[1:0], enbl[2], Y16 [11:8]);
    decoder2_4 dec5(W4[1:0], enbl[3], Y16 [15:12]);
endmodule


