// p15
`timescale 1ns / 1ps

module mux4(input [3:0] w, input [1:0] s, output reg f);
    
    always @(*) begin
        case(s)
        2'b00:f=w[0];
        2'b01:f=w[1];
        2'b10:f=w[2];
        2'b11:f=w[3];
        endcase
    end
    
        
endmodule


