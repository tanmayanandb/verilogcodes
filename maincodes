module binarytogray(input [3:0] bcode, output reg [3:0] gcode);

    integer i;

    
    always @(*) begin
        gcode[3] = bcode[3];
        for(i=0;i<3;i=i+1) begin
            gcode[2-i] = bcode[2-i] ^ bcode[3-i]; 
        end
    end
    
endmodule

