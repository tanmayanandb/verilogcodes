module decoder2_4(input [1:0] W, input En, output reg [3:0] Y);

    always @(W, En) begin
        if(En == 0)
            Y = 4'b0000;
        else
            case(W)
                0: Y = 4'b0001;
                1: Y = 4'b0010;
                2: Y = 4'b0100;
                3: Y = 4'b1000;
            endcase
    end

endmodule

