`timescale 1ns / 1ps

module mux2(input [1:0] w1, input s1, output reg f1);
    always @(*) begin
    if(s1==1'b0)
        f1=w1[0];
    else
        f1=w1[1];
    end
endmodule

module mux8(input [7:0] w, input [2:0] s, output reg f);
    
    always @(*) begin
        case(s)
        3'b000:f=w[0];
        3'b001:f=w[1];
        3'b010:f=w[2];
        3'b011:f=w[3];
        3'b100:f=w[4];
        3'b101:f=w[5];
        3'b110:f=w[6];
        3'b111:f=w[7];
        
        endcase
    end
    
        
endmodule

